---
// Shared filters and patterns for every drawing on the page. Rendered once.
---

<svg class="ink-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <!-- A fine-liner never sits exactly on the ruler. -->
    <filter id="ink" x="-4%" y="-4%" width="108%" height="108%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <!-- Line boil, like a hand-drawn animation cel, while something moves. -->
    <filter id="ink-boil" x="-4%" y="-4%" width="108%" height="108%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="1" result="n">
        <animate attributeName="seed" values="1;5;9" dur="0.36s" calcMode="discrete" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <pattern id="hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="4" class="hatch-line" />
    </pattern>
    <pattern id="hatch-wide" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="7" class="hatch-line hatch-line--faint" />
    </pattern>
    <pattern id="hatch-red" width="3.2" height="3.2" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="3.2" class="hatch-line hatch-line--red" />
    </pattern>
    <radialGradient id="vignette-g" cx="0.5" cy="0.48" r="0.55">
      <stop offset="0.55" stop-color="#fff" />
      <stop offset="1" stop-color="#000" />
    </radialGradient>
    <mask id="vignette" maskContentUnits="objectBoundingBox">
      <rect width="1" height="1" fill="url(#vignette-g)" />
    </mask>
  </defs>
</svg>
