---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Notes, Boon Jin" description="Notes on practical AI for teachers, classroom products, Deck.Toys and building as a solo founder.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      <p>Short notes on building Deck.Toys and AI for teachers.</p>
    </header>
    <ul class="note-list">
      {posts.map((post) => (
        <li>
          <a class="note-link" href={`/writing/${post.slug}/`}>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
